{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "orca",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "vendor/orca"]
}
